{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BrowserConfig": {
      "additionalProperties": false,
      "description": "執行這個場景的瀏覽器設定。",
      "properties": {
        "engine": {
          "default": "chromium",
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ],
          "title": "Engine",
          "type": "string"
        },
        "headless": {
          "default": true,
          "title": "Headless",
          "type": "boolean"
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Viewport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseUrl": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseurl"
        },
        "locale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        }
      },
      "title": "BrowserConfig",
      "type": "object"
    },
    "ClickStep": {
      "additionalProperties": false,
      "description": "點擊元素。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "click",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Locator"
        },
        "button": {
          "default": "left",
          "enum": [
            "left",
            "right",
            "middle"
          ],
          "title": "Button",
          "type": "string"
        },
        "clickCount": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Clickcount",
          "type": "integer"
        },
        "modifiers": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Alt",
                  "Control",
                  "ControlOrMeta",
                  "Meta",
                  "Shift"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modifiers"
        }
      },
      "required": [
        "id",
        "action",
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "所有步驟共用的預設值。",
      "properties": {
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "ExpectStep": {
      "additionalProperties": false,
      "description": "斷言：條件不成立時這一步失敗（會等到 timeout 才判定）。\n\n有 target 時檢查元素：state、text、value、count 其一；\n沒有 target 時檢查頁面：url、title 其一。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "expect",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "visible",
                "hidden",
                "enabled",
                "disabled",
                "checked",
                "unchecked",
                "editable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "match": {
          "default": "contains",
          "enum": [
            "contains",
            "equals",
            "regex"
          ],
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "ExpectStep",
      "type": "object"
    },
    "ExtractField": {
      "additionalProperties": false,
      "description": "extract 的 fields 中的一個欄位：相對於每個符合元素的子元素。",
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "get": {
          "default": "text",
          "enum": [
            "text",
            "value",
            "html",
            "attribute"
          ],
          "title": "Get",
          "type": "string"
        },
        "attribute": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        }
      },
      "title": "ExtractField",
      "type": "object"
    },
    "ExtractStep": {
      "additionalProperties": false,
      "description": "從頁面抽取資料，存成變數。\n\n- 預設抽取第一個符合元素的文字；``multiple: true`` 抽取全部，得到清單。\n- ``fields``：每個元素抽成一筆記錄（例如表格的每一列）。\n- ``get: table``：把 <table> 依表頭轉成記錄清單。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "extract",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Locator"
        },
        "as": {
          "title": "As",
          "type": "string"
        },
        "get": {
          "default": "text",
          "enum": [
            "text",
            "value",
            "html",
            "attribute",
            "table"
          ],
          "title": "Get",
          "type": "string"
        },
        "attribute": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "multiple": {
          "default": false,
          "title": "Multiple",
          "type": "boolean"
        },
        "fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ExtractField"
              },
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        }
      },
      "required": [
        "id",
        "action",
        "target",
        "as"
      ],
      "title": "ExtractStep",
      "type": "object"
    },
    "FillStep": {
      "additionalProperties": false,
      "description": "清空輸入框後填入文字。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "fill",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Locator"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "target",
        "value"
      ],
      "title": "FillStep",
      "type": "object"
    },
    "GotoStep": {
      "additionalProperties": false,
      "description": "開啟網址。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "goto",
          "title": "Action",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "waitUntil": {
          "default": "load",
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle",
            "commit"
          ],
          "title": "Waituntil",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "url"
      ],
      "title": "GotoStep",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "description": "一個入參：執行時由使用者、API 或上游場景的出參提供。啟動瀏覽器之前校驗。",
      "properties": {
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enum": {
          "anyOf": [
            {
              "items": {},
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "minLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minlength"
        },
        "maxLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "pattern": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "default": {
          "default": null,
          "title": "Default"
        }
      },
      "title": "InputSpec",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "頁面元素的定位器。\n\n範例::\n\n    { role: button, name: 登入 }\n    { label: 密碼 }\n    { css: \"tr\", hasText: 訂單 123, within: { role: table, name: 訂單 } }",
      "properties": {
        "testId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testid"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "alert",
                "alertdialog",
                "application",
                "article",
                "banner",
                "blockquote",
                "button",
                "caption",
                "cell",
                "checkbox",
                "code",
                "columnheader",
                "combobox",
                "complementary",
                "contentinfo",
                "definition",
                "deletion",
                "dialog",
                "directory",
                "document",
                "emphasis",
                "feed",
                "figure",
                "form",
                "generic",
                "grid",
                "gridcell",
                "group",
                "heading",
                "img",
                "insertion",
                "link",
                "list",
                "listbox",
                "listitem",
                "log",
                "main",
                "marquee",
                "math",
                "menu",
                "menubar",
                "menuitem",
                "menuitemcheckbox",
                "menuitemradio",
                "meter",
                "navigation",
                "none",
                "note",
                "option",
                "paragraph",
                "presentation",
                "progressbar",
                "radio",
                "radiogroup",
                "region",
                "row",
                "rowgroup",
                "rowheader",
                "scrollbar",
                "search",
                "searchbox",
                "separator",
                "slider",
                "spinbutton",
                "status",
                "strong",
                "subscript",
                "superscript",
                "switch",
                "tab",
                "table",
                "tablist",
                "tabpanel",
                "term",
                "textbox",
                "time",
                "timer",
                "toolbar",
                "tooltip",
                "tree",
                "treegrid",
                "treeitem"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "placeholder": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "altText": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alttext"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "css": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Css"
        },
        "xpath": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpath"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "nth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nth"
        },
        "hasText": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hastext"
        },
        "within": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallback": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Locator"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback"
        }
      },
      "title": "Locator",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "description": "一個出參：自動化與獨立斷言都通過之後才發布，可以串到下游場景的入參。",
      "properties": {
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enum": {
          "anyOf": [
            {
              "items": {},
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "minLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minlength"
        },
        "maxLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "pattern": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "from": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        }
      },
      "title": "OutputSpec",
      "type": "object"
    },
    "PressStep": {
      "additionalProperties": false,
      "description": "按鍵或組合鍵。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "action": {
          "const": "press",
          "title": "Action",
          "type": "string"
        },
        "key": {
          "minLength": 1,
