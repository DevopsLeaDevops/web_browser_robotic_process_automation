# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# 工具快取
.pytest_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/
# CI 產生的報告（tools/ci_annotations.py 讀取）
pyright.json
pytest-report.xml

# 執行產物（截圖、Trace、下載檔）
artifacts/
test-results/

# 本機設定與機密
.env
.env.*
!.env.example
*.local.yaml

# 編輯器與系統
.idea/
.vscode/
.DS_Store

# rpa run 的執行目錄
runs/

# rpa serve 的資料目錄（SQLite、場景版本、執行目錄、登入狀態、Secrets）
# 也忽略 --data 另外指定的 data-*（例如 data-m4），避免把登入狀態與 Secrets 提交進去
/data/
/data-*/
