{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "recordId",
    "quantity"
  ],
  "additionalProperties": false,
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^DEMO-[A-Z0-9]+$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "expectedTitle": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  }
}