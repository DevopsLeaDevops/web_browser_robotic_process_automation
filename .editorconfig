root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yaml,yml,toml}]
indent_size = 2

# 原樣收錄的設計包，不套用任何格式規則
[docs/design-system/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
